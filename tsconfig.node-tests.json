{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-test",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "declaration": false,
    "types": []
  },
  "include": [
    "src/domain/**/*.ts",
    "src/data/indexes.ts",
    "src/data/validate.ts",
    "src/app/filterReducer.ts",
    "src/domain/exploration.ts",
    "src/domain/exportCsv.ts",
    "src/domain/savedViews.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test"
  ]
}
